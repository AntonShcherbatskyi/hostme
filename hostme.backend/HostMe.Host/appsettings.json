{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HostMe",
    "Audience": "HostMe",
    "ExpiryMinutes": 60
  },
  "S3": {
    "BucketName": "hostme-static-sites",
    "Region": "eu-west-2"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://hostme-init.s3-website.eu-west-2.amazonaws.com"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:80"
      }
    }
  }
}
