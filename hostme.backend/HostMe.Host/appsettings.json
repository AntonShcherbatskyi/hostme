{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "CONNECTION_STRING"
  },
  "Jwt": {
    "Secret": "JWT_SECRET",
    "Issuer": "HostMe",
    "Audience": "HostMe",
    "ExpiryMinutes": 60
  }
}
