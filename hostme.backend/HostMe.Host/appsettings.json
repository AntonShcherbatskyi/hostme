{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "CONNECTION_STRING"
  },
  "Jwt": {
    "Secret": "JWT_SECRET",
    "Issuer": "HostMe",
    "Audience": "HostMe",
    "ExpiryMinutes": 60
  },
  "S3": {
    "BucketName": "S3_BUCKET_NAME",
    "AccessKey": "S3_ACCESS_KEY",
    "SecretKey": "S3_SECRET_KEY",
    "Region": "S3_REGION"
  }
}
